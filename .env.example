# Copy this file to .env and fill in the values you need.
# .env is gitignored -- never commit real secrets.

# --- LLM ---------------------------------------------------------------
# Enables OpenAI for chat + embeddings. Without it, falls back to a local
# Ollama model (llama3.1:8b by default).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Only used if EMBEDDING_PROVIDER=openai; otherwise embeddings run locally
# via fastembed.
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_MODEL=llama3.1:8b

# --- Qdrant --------------------------------------------------------------
QDRANT_URL=http://localhost:6333
# Only needed for a hosted/remote Qdrant instance that requires auth.
QDRANT_API_KEY=

# --- HuggingFace (dataset downloads for ingestion) ------------------------
HF_TOKEN=

# --- Jira (support ticket escalation / status lookup) ---------------------
JIRA_URL=
JIRA_AUTH_EMAIL=
JIRA_API_TOKEN=

# --- LangSmith (tracing + evaluate_agent.py) ------------------------------
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
LANGSMITH_PROJECT=
